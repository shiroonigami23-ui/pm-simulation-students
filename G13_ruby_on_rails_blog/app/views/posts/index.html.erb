<h1 class="mb-4">Posts</h1>
<div class="row">
  <% @posts.each do |post| %>
  <div class="col-md-4 mb-4">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title"><%= post.title %></h5>
        <p class="card-text text-muted small"><%= truncate(post.body.to_plain_text, length: 100) %></p>
      </div>
      <div class="card-footer d-flex justify-content-between">
        <small class="text-muted"><%= post.user.username %></small>
        <%= link_to 'Read', post_path(post.slug), class: 'btn btn-sm btn-primary' %>
      </div>
    </div>
  </div>
  <% end %>
</div>
